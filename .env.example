# BigBotArt LLM 配置示例(复制为 .env 或注入环境变量)
# Agent 规划内核:远端 OpenAI 兼容 LLM(优先)→ 本地 LM Studio(回退)→ 确定性模板(兜底)

# --- 远端 LLM(任一 OpenAI 兼容端点)---
# DeepSeek
BIGBOTART_LLM_BASE_URL=https://api.deepseek.com/v1
BIGBOTART_LLM_API_KEY=sk-your-key
BIGBOTART_LLM_MODEL=deepseek-chat

# --- 其他可选端点 ---
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
# MiniMax:  https://api.minimax.chat/v1  模型 MiniMax-M2
# Kimi:     https://api.moonshot.cn/v1  模型 moonshot-v1-8k

# --- 本地 LM Studio(未配置远端时自动使用)---
# BIGBOTART_LMSTUDIO_URL=http://127.0.0.1:1234/v1
# BIGBOTART_LMSTUDIO_MODEL=ornith-1.5-35b-a3b-abliterated-mlx

# --- 引擎 ---
# 关闭 dry-run 后真实调用 h3.c / mlxgen(慢、吃内存;preview 也要约数分钟)
BIGBOTART_DRYRUN=0
# BIGBOTART_HOME=~/.bigbotart
# BIGBOTART_H3_BIN=/path/to/h3
# BIGBOTART_H3_MODEL=/path/to/MiniMax-H3
# BIGBOTART_H3_OUTPUTS=.bigbotart/outputs
# --- 图片引擎 mlxgen(安装/模型管理见 docs/mlxgen-图片引擎-安装与模型管理.md)---
# BIGBOTART_MLXGEN_OUTPUTS=~/.bigbotart/outputs/images   # mlxgen 图片产物目录
# 模型下载:设置页「模型下载」一键下载;Qwen 系默认走 ModelScope 国内 CDN 直连(不依赖 HF 可达性),
#   其余模型走 mlxgen download(HF)。设 0 可强制全部走 HF:
# BIGBOTART_MS_DOWNLOAD=0
#   (默认文生图 AbstractFramework/z-image-turbo-8bit;编辑 qwen-image-edit;超分 AbstractFramework/seedvr2-3b-8bit)
# 本地模型目录:该目录下已就绪的模型(transformer/ 有权重分片)直接当 --model 用,免重复下载。
#   默认 ~/ai/models,例:~/ai/models/qwen-image-2.1-mlx-8bit → 检查器选 Qwen-Image-2.1 即用本地
# BIGBOTART_MODELS_DIR=~/ai/models

# --- 视频增强(超分 + 合修脸)工具链:video-upscale 节点用 ---
# 纯本地后处理,**统一 PyTorch 管线**(basicsr.RealESRGANer + GFPGAN/CodeFormer):
#   超分与修脸在同一 Python 进程内完成,只拆一次帧、只拼一次回,省掉一轮完整编解码。
# 不加载 h3 模型、不受 dry-run 影响;但属分钟级长任务,只由用户显式触发。
# 实现:apps/desktop/src/main/video-post.ts + ~/ai/face-fix/video_post.py
# BIGBOTART_VIDEO_POST_SCRIPT=~/ai/face-fix/video_post.py   # 统一后处理脚本(超分+修脸)
# BIGBOTART_SUPERRES_PYTHON=~/venvs/superres/bin/python     # 后处理解释器(torch/facexlib/basicsr/gfpgan)
# BIGBOTART_GFPGAN_ROOT=~/ai/GFPGAN                         # GFPGAN 仓库根;同时作为子进程 cwd
#   ⚠️ 必须是 cwd:GFPGAN 的 FaceRestoreHelper(model_rootpath='gfpgan/weights') 是相对路径,
#      facexlib 按进程 CWD 解析;cwd 不对会把本地已有的 facexlib 权重当缺失,去 GitHub 重下 100MB+
# BIGBOTART_CODEFORMER_ROOT=~/ai/CodeFormer                 # 仅用其 facelib;basicsr 一律用官方版
#   ⚠️ 它的 vendored basicsr 与官方撞 ARCH_REGISTRY 注册名,故不进 sys.path(脚本已处理)
# BIGBOTART_WEIGHTS_DIR=~/ai/weights                        # 权重目录:
#   RealESRGAN_x4plus.pth  超分(PyTorch .pth;**不能**用 ncnn 的 .bin/.param)
#   GFPGANv1.4.pth / codeformer.pth / detection_Resnet50_Final.pth / parsing_parsenet.pth
