# 复制为 /etc/bigbotart-relay.env 后填实值。本文件不要写真实密钥。
BBA_RELAY_DOMAIN=art.example.com
BBA_RELAY_EMAIL=you@example.com
BBA_RELAY_DATA_DIR=/var/lib/bigbotart-relay
# 不填则首次启动生成并打印一次。生成后的明文在数据目录 pairing.key(0600)。
# BBA_RELAY_PAIRING_KEY=

# ── 形态 A(推荐):nginx 反代,中继只监听回环 HTTP ──────────────────
# 公网入口由 nginx 提供,证书与续期都交给 nginx/Certbot。
# 前缀(如 /bba)在 nginx 侧剥掉,中继看到的仍是干净的 /、/rpc、/events。
BBA_RELAY_MODE=http
BBA_RELAY_PORT=8443
BBA_RELAY_LISTEN=127.0.0.1

# ── 形态 B:中继自己终止 HTTPS ───────────────────────────────────
# 把上面三行换成:
# BBA_RELAY_MODE=https
# BBA_RELAY_LISTEN=0.0.0.0
# BBA_RELAY_HTTPS_PORT=443
# 自带证书时填写,不会自动续期。留空则用 Let's Encrypt HTTP-01。
# BBA_RELAY_CERT=/etc/bigbotart-relay/fullchain.pem
# BBA_RELAY_KEY=/etc/bigbotart-relay/privkey.pem
# BBA_RELAY_HTTP_PORT=80
# 调试用,正式环境不要设:
# BBA_RELAY_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
