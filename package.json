{
  "name": "bigbotart",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "BigBotArt — 无限画布的视频/图片生成 Agent(跨端桌面 App,本地优先)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE BIGBOTART_DRYRUN=0 pnpm --filter @bigbotart/desktop dev",
    "dev:dry": "env -u ELECTRON_RUN_AS_NODE BIGBOTART_DRYRUN=1 pnpm --filter @bigbotart/desktop dev",
    "build": "pnpm --filter @bigbotart/desktop build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "start": "env -u ELECTRON_RUN_AS_NODE BIGBOTART_DRYRUN=0 pnpm --filter @bigbotart/desktop start"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@11.0.8",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "vitest": "^3.2.7"
  }
}